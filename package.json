{
  "name": "marksy",
  "version": "0.1.0",
  "private": true,
  "description": "Family PWA for school marks from the e-diary",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": "https://github.com/Dopetast1c/Marksy",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @marksy/server --filter @marksy/web dev",
    "dev:lan": "pnpm --parallel --filter @marksy/server --filter @marksy/web dev:lan",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:scripts && pnpm privacy",
    "test:scripts": "vitest run --root scripts",
    "test:server": "pnpm --filter @marksy/server test",
    "test:web": "pnpm --filter @marksy/web test",
    "typecheck:server": "pnpm --filter @marksy/server typecheck",
    "typecheck:web": "pnpm --filter @marksy/web typecheck",
    "api:types": "pnpm --filter @marksy/web api:types",
    "tokens": "pnpm --filter @marksy/web tokens",
    "prepare": "node scripts/install-hooks.mjs",
    "privacy": "node scripts/privacy-check.mjs",
    "setup:env": "node scripts/init-env.mjs",
    "env:dev": "node scripts/env-dev.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:migrate": "pnpm --filter @marksy/server db:migrate",
    "db:seed": "pnpm --filter @marksy/server db:seed",
    "db:studio": "pnpm --filter @marksy/server db:studio",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:read": "node scripts/db-read.mjs",
    "db:export": "pnpm --filter @marksy/server db:export",
    "env:prod": "pnpm --filter @marksy/server env:prod",
    "i18n:check": "pnpm --filter @marksy/i18n i18n:check",
    "i18n:stamp": "pnpm --filter @marksy/i18n i18n:stamp",
    "test:provider": "node scripts/test-provider.mjs",
    "probe": "node scripts/probe.mjs",
    "sync:once": "pnpm --filter @marksy/server sync:once",
    "sync:plan": "pnpm --filter @marksy/server sync:plan",
    "dev:connect": "pnpm --filter @marksy/server dev:connect",
    "smoke:lan": "node --env-file-if-exists=.env scripts/smoke-lan.mjs",
    "smoke:ui": "node --env-file-if-exists=.env scripts/smoke-ui.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
