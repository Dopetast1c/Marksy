{
  "name": "marksy",
  "private": true,
  "description": "Family PWA for school marks from the e-diary",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @marksy/server --filter @marksy/web dev",
    "dev:lan": "pnpm --parallel --filter @marksy/server --filter @marksy/web dev:lan",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm privacy",
    "privacy": "node scripts/privacy-check.mjs",
    "setup:env": "node scripts/init-env.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:migrate": "pnpm --filter @marksy/server db:migrate",
    "db:studio": "pnpm --filter @marksy/server db:studio",
    "i18n:check": "pnpm --filter @marksy/i18n i18n:check",
    "test:provider": "node scripts/test-provider.mjs",
    "probe": "node scripts/probe.mjs",
    "sync:once": "pnpm --filter @marksy/server sync:once"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
