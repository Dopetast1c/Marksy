      },
      "newDot": "#5FB8CB",
      "holiday": { "bg": "#3A3112", "fg": "#F5D06A", "fill": "#C9A227" }
    },
    "subject": {
      "$description": "Subject palette (6.6): wayfinding colours chosen per subject by the family. hsl(h s l) built from these hues; grey is saturation 0. Never used for marks, bands, severity or direction.",
      "red": 4,
      "orange": 28,
      "yellow": 46,
      "lime": 88,
      "green": 150,
      "teal": 178,
      "sky": 202,
      "blue": 226,
      "violet": 262,
      "purple": 292,
      "pink": 330,
      "grey": null,
      "fill": "hsl(h 62% 46%)",
      "tint": "color-mix(in oklab, hsl(h 70% 50%) 9%, surface)",
      "textLightness": {
        "light": "32%",
        "dark": "74%"
      },
      "accent": {
        "$description": "The subject screen's accent (design.md 5.4, D45): the header and the navigator row on a tint of the subject colour, the title in a darker shade (lighter in the dark theme), the screen's controls in the subject colour with text in onAccent. Statistics, charts, mark chips and averages never take it.",
        "headerTint": "color-mix(in oklab, hsl(h s 50%) 16%, bg)",
        "soft": "color-mix(in oklab, hsl(h s 50%) 18%, surface)",
        "title": "color-mix(in oklab, hsl(h s text) 75%, ink)",
        "onAccent": {
          "light": "#FFFFFF",
          "dark": "#0F1420"
        }
      }
    }
  },
  "avatar": {
    "$description": "Colours of the generated avatars (ux-principles D9): traits, not theme, the same in both themes. web/src/components/Avatar.tsx draws with var(--av-<group>-<key>).",
    "skin": { "pale": "#FBE7D6", "light": "#F3D1B4", "medium": "#D9A878", "tan": "#B8805A", "brown": "#8D5A3B", "dark": "#5A3A2A" },
    "hair": { "black": "#1C1A1A", "dark": "#3B2A1E", "brown": "#6B4A2B", "lightbrown": "#A5703B", "blond": "#E3C16F", "red": "#B5472A", "grey": "#A6A6A6" },
    "eyes": { "brown": "#4E2E14", "hazel": "#8B6A2E", "green": "#4E8F5A", "blue": "#4A7BD0", "grey": "#7A8794" },
    "shirt": { "girl": "#C96A8A", "boy": "#4A77B8", "neutral": "#4A77B8" },
    "line": { "mouth": "#9E5A4A", "glasses": "#2B2B2B", "shine": "#FFFFFF" }
  },
  "bands": {
    "$note": "Numeric marks map to four bands. 'ok' is the neutral style for non-numeric kinds (зач., осв., н/а). 'top' is drawn filled so 9-10 read as exceptional next to the soft green of 7-8.",
    "critical": {
      "min": 1,
      "max": 4,
      "label": "низкие"
    },
    "low": {
      "min": 5,
      "max": 6,
      "label": "средние"
    },
    "good": {
      "min": 7,
      "max": 8,
      "label": "хорошие"
    },
    "top": {
      "min": 9,
      "max": 10,
      "label": "отличные"
    }
  },
  "font": {
    "display": "\"Fraunces\", Georgia, serif",
    "body": "\"Manrope\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "$files": "The app serves every font from its own origin (@fontsource packages in web); nothing is requested from a font CDN (design.md 12, 14.1). Only the prototype in docs/ links Google Fonts.",
    "bodyOptions": {
      "$description": "User-selectable body fonts (design.md 5.6a); display font stays Fraunces",
      "manrope": "\"Manrope\", system-ui, sans-serif",
      "nunito": "\"Nunito\", system-ui, sans-serif",
      "ptsans": "\"PT Sans\", system-ui, sans-serif",
      "inter": "\"Inter\", system-ui, sans-serif",
      "rubik": "\"Rubik\", system-ui, sans-serif"
    }
  },
  "typeScale": {
    "hero": {
      "size": "56px",
      "lineHeight": "1",
      "font": "display",
      "weight": 600
    },
    "tile": {
      "size": "28px",
      "lineHeight": "1.1",
      "font": "display",
      "weight": 600
    },
    "h1": {
      "size": "22px",
      "lineHeight": "1.2",
      "weight": 800
    },
    "h2": {
      "size": "17px",
      "lineHeight": "1.3",
      "weight": 700
    },
    "body": {
      "size": "15px",
      "lineHeight": "1.45",
      "weight": 500
    },
    "small": {
      "size": "13px",
      "lineHeight": "1.4",
      "weight": 500
    },
    "label": {
      "size": "11px",
      "lineHeight": "1.2",
      "weight": 700,
      "letterSpacing": "0.06em",
      "transform": "uppercase"
    }
  },
  "radius": {
    "sm": "8px",
    "md": "14px",
    "lg": "20px",
    "pill": "999px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px"
  },
  "shadow": {
    "card": "0 1px 2px rgba(23, 33, 58, 0.06), 0 4px 16px rgba(23, 33, 58, 0.06)",
    "cardDark": "0 1px 2px rgba(0, 0, 0, 0.3), 0 4px 16px rgba(0, 0, 0, 0.3)"
  },
  "tap": {
    "min": "44px"
  },
  "motion": {
    "$description": "Movement (ux-principles D2): when the period steps (swipe or ‹ ›) the screen's content slides in a short way from the side it came from; off with prefers-reduced-motion.",
    "periodSlide": {
      "distance": "24px",
      "duration": "180ms"
    }
  },
