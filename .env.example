# Copy to .env and fill in. Never commit .env.
# Descriptions of every variable: README.md, section "Configuration".

# --- Database (PostgreSQL 16, see docker-compose.yml) ---
DATABASE_URL=postgres://marksy:marksy@localhost:5432/marksy
# Used by `pnpm test` (Vitest + Supertest): the in-memory test server marksy-postgres-test on port 5434
# (docker-compose.yml), never the app's database
TEST_DATABASE_URL=postgres://marksy:marksy@localhost:5434/marksy_test

# --- Security ---
# Random string, 32+ characters (pnpm setup:env generates it). The key invite codes are stored under (HMAC); the API
# does not start without it.
SESSION_SECRET=
# 32 random bytes, base64. Encrypts diary passwords at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
CREDENTIALS_KEY=

# --- Collector. The diary address, request pauses, the school-day window and network needs come from the provider
# manifest (providers/<id>); the variables below can only make the provider's limits stricter. Empty = provider default. ---
SYNC_ENABLED=true
# Runs happen during each child's school day (from their timetable and bells). This is an outer bound on every child's
# window, local school time, e.g. 07:00-17:00; empty = no bound
SYNC_WINDOW=
# Random delay before every scheduled run, 0 to this many minutes
SYNC_JITTER_MIN=20
# Minimum time between two logins to the diary per account (schedule, manual refresh and re-scans share it), e.g. 60m
SYNC_MIN_LOGIN_INTERVAL=

# --- Collector resilience (docs/design.md 10.4). The server is a home machine: it can be off for days, the diary can be down. ---
# Planner tick; every tick decides from recorded state what to fetch, so an outage is caught up automatically
SYNC_TICK_MIN=5
# A run outside the window is allowed when the last successful sync is older than this (catch-up after the device was off)
SYNC_CATCHUP_AFTER=24h
# Requests per run cap (manifest limits.maxRequestsPerRun unless this is lower); the rest waits for the next run
SYNC_MAX_REQUESTS_PER_RUN=40
# Consecutive failed attempts (diary reached but failing) before the account is paused; then the pause, doubling up to the cap
SYNC_FAILURES_BEFORE_PAUSE=3
SYNC_PAUSE_HOURS=24
SYNC_PAUSE_MAX_HOURS=168
# When this machine itself is offline (DNS/TCP to the diary fails) nothing is counted; retry after
SYNC_OFFLINE_RETRY_MIN=10

# --- Retention (days). Marks and their history are kept for the student's lifetime in the family; this is for operational data. ---
# Older sync runs are compacted into one line per day
RETENTION_SYNC_RUNS_DAYS=90
# Raw diary responses; the one that verified a week of the current term is kept for re-parsing
RETENTION_RAW_RESPONSES_DAYS=14
# Mark events (new, changed, removed), "готово" tick events and the notifications inbox
RETENTION_MARK_EVENTS_DAYS=180
# Pause and resume events of study sessions
RETENTION_STUDY_EVENTS_DAYS=180
# Acknowledged API drift events that stopped occurring
RETENTION_DRIFT_ACKED_DAYS=180
# Tag hits after their due date
RETENTION_TAG_HITS_DAYS=30
# Sync coverage, study sessions and "урока не будет" are kept for the current school year and this many before it
RETENTION_PREVIOUS_SCHOOL_YEARS=1
# study time (docs/design.md 6.7): estimates from "готово" ticks, minutes
STUDY_INFER_MIN_GAP_MIN=3
STUDY_INFER_MAX_GAP_MIN=90
STUDY_INFER_APP_OPEN_WINDOW_MIN=90

# --- Notifications (optional) ---
# Web Push: generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Telegram bot from @BotFather; webhook secret is any random string
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Server ---
PORT=3000
# The API binds to this address. Keep 127.0.0.1: phones and other devices reach it through the PWA server (/api proxy).
HOST=127.0.0.1
PUBLIC_URL=http://localhost:5173
# IANA time zone of the school, e.g. Europe/Warsaw; pnpm setup:env fills in this computer's zone
TZ=

# --- Development only: your own family on your own machine (docs/build-plan.md, "Data for testing") ---
# Your diary login. Used by `pnpm probe` (M2), `pnpm sync:once` (M3) and `pnpm dev:connect` (M4); Claude Code may run
# them within the login guard (CLAUDE.md, "Real diary runs"). The app itself keeps diary credentials in the
# database, encrypted; these two lines exist only so you do not type them into the UI after every database reset.
# .env is gitignored and Claude Code is not allowed to read it.
DIARY_LOGIN=
DIARY_PASSWORD=
# The limits of the manual real runs (pnpm probe, pnpm sync:once, pnpm dev:connect; server/src/cli/mode.ts).
# development (exactly this word): one diary login per account every DEV_MIN_LOGIN_INTERVAL_MINUTES (10 or more; a
# lower value counts as 10), at any hour, no daily cap. Anything else, an empty or misspelt value included, is
# production: the provider's interval (60 minutes for most), and Claude Code at most three runs a day between 07:00
# and 20:00 school time. On the machine that runs the app for the family, set production. In both, Claude Code never
# retries a login the diary refused, and scheduled syncs keep the product's rules (docs/design.md 10.2).
MARKSY_ENV=development
DEV_MIN_LOGIN_INTERVAL_MINUTES=10
# A production build sets NODE_ENV=production, which always means the production mode above, whatever MARKSY_ENV says.
# Leave it unset for development.
# NODE_ENV=production
# Who starts a manual real run: empty for you; .claude/settings.json sets "claude" for Claude Code, whose runs in
# production the login guard limits to three a day in school hours. Leave it empty here.
MARKSY_RUNNER=
# The Marksy login `pnpm dev:connect` creates for you (any e-mail you like; it never leaves this machine)
MARKSY_DEV_EMAIL=
MARKSY_DEV_PASSWORD=

# --- Tests only ---
# 1 rewrites providers/<id>/fixtures/expected/canonical.json in `pnpm test:provider <id>` (refused while any fixture
# carries something on the provider's denylist). Set it on the command line for one run, not here.
MARKSY_UPDATE_EXPECTED=
# 1 makes `pnpm probe` print the command it would run and stop, without logging in: for testing the launcher.
MARKSY_PROBE_DRY_RUN=
