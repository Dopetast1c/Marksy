{
  "id": "by-eschools",
  "name": "Электронная школа (e-schools.by)",
  "country": "BY",
  "region": null,
  "scope": "national",
  "website": "https://diary.e-schools.by",
  "status": "beta",
  "maintainers": [],
  "languages": { "default": "ru", "preferred": ["ru", "be"] },
  "calendar": { "weekStart": 1, "weekend": [6, 0], "schoolDays": [1, 2, 3, 4, 5, 6] },
  "nameOrder": "family-first",
  "timezone": "Europe/Minsk",
  "roles": ["parent"],
  "tenant": null,
  "auth": {
    "kind": "password",
    "fields": [
      { "key": "login", "label": { "ru": "Логин", "be": "Лагін", "en": "Login" }, "type": "text" },
      { "key": "password", "label": { "ru": "Пароль", "be": "Пароль", "en": "Password" }, "type": "password" }
    ],
    "loginRequest": "POST /api/v1/auth/login/parent"
  },
  "gradingScale": "by-10",
  "capabilities": {
    "lessons": true,
    "futureTimetable": true,
    "topics": true,
    "homework": true,
    "attachments": false,
    "lessonTypes": true,
    "marksPerLesson": "one",
    "unattachedMarks": false,
    "workTypes": true,
    "comments": true,
    "weights": false,
    "attendance": "derived",
    "terms": "quarter",
    "finalMarks": true,
    "teacherNames": false,
    "pastYears": false,
    "homeworkAssignments": false,
    "behaviour": false,
    "cohortStats": false,
    "criteria": false,
    "targets": false,
    "exams": false
  },
  "network": {
    "baseUrl": "https://diary.e-schools.by",
    "regionHint": "BY",
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36",
    "notes": "Requests must leave from a Belarusian IP without a VPN; 503 or a hanging connection usually means a VPN is in the path (docs/api-spec.md 8, 9.1)"
  },
  "limits": {
    "minLoginIntervalMinutes": 60,
    "requestDelayMs": [1500, 3000],
    "maxRequestsPerRun": 40,
    "syncWindow": "08:00-14:00",
    "weeklyRescan": "fri 20:00-23:00",
    "fetchUnit": "week",
    "authFailureIsFinal": true
  },
  "homeworkSemantics": "assigned-at-lesson",
  "readOnlyAllowList": [
    "POST /api/v1/auth/login/parent",
    "GET /api/v1/admin/auth/me",
    "GET /api/v1/education/diary/school_year",
    "GET /api/v1/education/diary/time_activities",
    "GET /api/v1/education/diary/time_activities/week_activities",
    "GET /api/v1/education/diary/schools/*/students/*/classes",
    "GET /api/v1/education/diary/schools/*/classes/*/students/*/educational_subjects",
    "GET /api/v1/education/diary/schools/*/classes/*/students/*/lessons",
    "GET /api/v1/education/diary/schools/*/classes/*/students/*/final/whole"
  ]
}
