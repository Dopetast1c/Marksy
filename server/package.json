{
  "name": "@marksy/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express API, collector, Drizzle schema and migrations",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "dev:lan": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "sync:once": "tsx --env-file-if-exists=../.env scripts/sync-once.ts",
    "db:seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
    "sync:plan": "tsx --env-file-if-exists=../.env scripts/sync-plan.ts",
    "login:claim": "tsx --env-file-if-exists=../.env scripts/login-claim.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@marksy/core": "workspace:*",
    "@marksy/registry": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7",
    "@marksy/demo-diary": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
