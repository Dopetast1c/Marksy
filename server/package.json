{
  "name": "@marksy/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express API, collector, Drizzle schema and migrations",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
