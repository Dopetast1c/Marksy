{
  "name": "@marksy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React + Vite PWA",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "tokens": "node --import tsx scripts/tokens-to-css.ts",
    "updating-page": "node --import tsx scripts/updating-page.ts",
    "api:types": "pnpm --filter @marksy/server openapi && node --import tsx scripts/api-types.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@marksy/core": "workspace:*",
    "@marksy/i18n": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "i18next": "^26.5.10",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-router": "^8.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
