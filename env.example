# Copy to .env and fill in. Never commit .env.
# Descriptions of every variable: README.md, section "Configuration".

# --- Database (PostgreSQL 16, see docker-compose.yml) ---
DATABASE_URL=postgres://marksy:marksy@localhost:5432/marksy
# Used by `pnpm test` (Vitest + Supertest): the in-memory test server marksy-postgres-test on port 5434
# (docker-compose.yml), never the app's database
TEST_DATABASE_URL=postgres://marksy:marksy@localhost:5434/marksy_test

# --- Security ---
# Random string, 32+ characters (pnpm setup:env generates it). The key invite codes are stored under (HMAC); the API
# does not start without it.
SESSION_SECRET=
# 32 random bytes, base64. Encrypts diary passwords at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
CREDENTIALS_KEY=

# --- Collector. The diary address, request pauses, the school-day window and network needs come from the provider
# manifest (providers/<id>); the variables below can only make the provider's limits stricter. Empty = provider default. ---
SYNC_ENABLED=true
# Runs happen during each child's school day (from their timetable and bells). This is an outer bound on every child's
# window, local school time, e.g. 07:00-17:00; empty = no bound
SYNC_WINDOW=
# Random delay before every scheduled run, 0 to this many minutes
SYNC_JITTER_MIN=20
# Minimum time between two logins to the diary per account (schedule, manual refresh and re-scans share it), e.g. 60m
SYNC_MIN_LOGIN_INTERVAL=

# --- Collector resilience (docs/design.md 10.4). The server is a home machine: it can be off for days, the diary can be down. ---
# Planner tick; every tick decides from recorded state what to fetch, so an outage is caught up automatically
SYNC_TICK_MIN=5
# A run outside the window is allowed when the last successful sync is older than this (catch-up after the device was
# off), only on a school day: at weekends and in the holidays only a week never read, or the one run that reads the
# nearest school week when the last school day did not (docs/design.md 10.2, ux-principles D55)
SYNC_CATCHUP_AFTER=24h
# Requests per run cap (manifest limits.maxRequestsPerRun unless this is lower); the rest waits for the next run
SYNC_MAX_REQUESTS_PER_RUN=40
# Consecutive failed attempts (diary reached but failing) before the account is paused; then the pause, doubling up to the cap
SYNC_FAILURES_BEFORE_PAUSE=3
SYNC_PAUSE_HOURS=24
SYNC_PAUSE_MAX_HOURS=168
# When this machine itself is offline (DNS/TCP to the diary fails) nothing is counted; retry after
SYNC_OFFLINE_RETRY_MIN=10

# --- Retention (days). Marks and their history are kept for the student's lifetime in the family; this is for operational data. ---
# Older sync runs are compacted into one line per day
RETENTION_SYNC_RUNS_DAYS=90
# Raw diary responses; the one that verified a week of the current term is kept for re-parsing
RETENTION_RAW_RESPONSES_DAYS=14
# Mark events (new, changed, removed), "ready" tick events and the notifications inbox
RETENTION_MARK_EVENTS_DAYS=180
# Pause and resume events of study sessions
RETENTION_STUDY_EVENTS_DAYS=180
# Acknowledged API drift events that stopped occurring
RETENTION_DRIFT_ACKED_DAYS=180
# Tag hits after their due date
RETENTION_TAG_HITS_DAYS=30
# Sync coverage, study sessions and "lesson won't take place" marks are kept for the current school year and this many before it
RETENTION_PREVIOUS_SCHOOL_YEARS=1
# study time (docs/design.md 6.7): estimates from "ready" ticks, minutes
STUDY_INFER_MIN_GAP_MIN=3
STUDY_INFER_MAX_GAP_MIN=90
STUDY_INFER_APP_OPEN_WINDOW_MIN=90

# --- Notifications (optional) ---
# Web Push: generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Telegram bot from @BotFather; webhook secret is any random string
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Server ---
PORT=3000
# The API binds to this address. Keep 127.0.0.1 in development: phones and other devices reach it through the PWA
# server (/api proxy). The production image listens on 0.0.0.0 inside the compose network, behind the reverse proxy.
HOST=127.0.0.1
# Used only by `pnpm db:seed` to refuse a public instance (the demo logins have a published password)
PUBLIC_URL=http://localhost:5173
# IANA time zone of the school, e.g. Europe/Warsaw; pnpm setup:env fills in this computer's zone. Empty in production:
# UTC (docker-compose.prod.yml)
TZ=
# Uploaded pictures (a child's photo, a wallpaper): checked and stripped of metadata, kept here, never in git.
# Empty: data/uploads in the repository folder (gitignored with data/)
UPLOADS_DIR=
# Connections per database pool (the server keeps two: the API and the collector). Lower it on a small host.
DB_POOL_MAX=10
# The path the app is served under: / (the root) or a plain path such as /marksy. One image serves any path; the
# session cookie, the API and every link follow it (docs/running.md)
BASE_PATH=/
# The proxies whose X-Forwarded-For and X-Forwarded-Proto are believed (Express syntax: loopback, a subnet, a list).
# A session cookie is Secure when the request came over https as the trusted proxy says; plain http is answered only
# from private addresses. Production: loopback plus the compose network's subnet (MARKSY_EDGE_SUBNET)
TRUST_PROXY=loopback
# Who may connect a diary without a session, which creates a family: open (anyone), first (only while the instance has
# no family yet), closed. Empty: open in development, first in production
SIGNUP=
# Swagger UI at /api/docs and the OpenAPI document: open, session (signed-in only) or off. Empty: open in development,
# session in production
API_DOCS=
# The internal status and hold port of the server, for the backup service, the updater and `marksy status`; never
# routed by the proxy. On only when MARKSY_INTERNAL_TOKEN is set (32+ characters; init-env generates it)
INTERNAL_PORT=3001
MARKSY_INTERNAL_TOKEN=
# Where the commands inside the containers find the server's internal port and the backup service
SERVER_INTERNAL_URL=http://server:3001
BACKUP_INTERNAL_URL=http://backup:3002
# Set by the image, never by hand: the version and commit it was built from (/api/health reports them)
MARKSY_VERSION=
MARKSY_COMMIT=

# --- Production (docker-compose.prod.yml, docs/running.md). `marksy init-env` writes these into .env.production. ---
# The release line this host follows, which is also the tag of the images: 1 (every 1.x release, the default), 1.4 (only
# fixes of 1.4), 1.4.2 (pinned), stable (every release, a new major version too). Before the first release: preview.
UPDATE_CHANNEL=1
# The database password of the production compose; DATABASE_URL above uses it
POSTGRES_PASSWORD=
# Postgres memory: the small profile fits a 1 GB Raspberry Pi; a laptop or a NAS can take the large one (runbook)
PG_SHARED_BUFFERS=64MB
PG_EFFECTIVE_CACHE_SIZE=256MB
PG_WORK_MEM=2MB
PG_MAINTENANCE_WORK_MEM=32MB
PG_MAX_CONNECTIONS=30
# The reverse proxy: the port it publishes on the host (option A: 80; option C: another one), an optional host name it
# answers to (option D), and the address of another proxy in front of it whose forwarded headers it believes (the
# Synology reverse proxy of option D). docs/running.md, "Ways in"
PROXY_PORT=80
PROXY_HOST=
PROXY_TRUSTED_EXTRA=
# The compose network of the proxy, the web app, the server and cloudflared; TRUST_PROXY names it
MARKSY_EDGE_SUBNET=172.30.57.0/24
# Option B: the proxy's own address on the home network (docker-compose.macvlan.yml), the network it is on and the
# host's network card
MACVLAN_ADDRESS=
MACVLAN_SUBNET=
MACVLAN_GATEWAY=
MACVLAN_PARENT=
# Cloudflare Tunnel (profile "tunnel"): the tunnel's token from the Cloudflare dashboard
TUNNEL_TOKEN=
# The secret the release workflow signs its update nudge with (HMAC-SHA256); init-env generates it, and
# `marksy init-env <file> --show-hook-secret` prints it once for the repository's secrets
UPDATE_HOOK_SECRET=

# --- Updates (the updater service, docs/running.md, "Updates") ---
# A time of day when no update installs, local time (TZ), e.g. 22:00-07:00; empty: any time outside a collector run
UPDATE_QUIET_HOURS=
# true: no automatic update (a manual `marksy update now` still works); `marksy update pause` does the same until resume
UPDATE_PAUSED=false
# How often the registry is asked for a new release (minutes, 0 to 20 % later each time); the hook asks at once
UPDATE_POLL_MINUTES=5
# How long a replaced container may take to become healthy before the update is rolled back (seconds, 30 or more)
UPDATE_HEALTH_TIMEOUT_SECONDS=300
# How long an update waits for a running diary read to end before it tries again later (minutes)
UPDATE_COLLECTOR_WAIT_MINUTES=20
# The free disk space an update needs before it pulls anything (MB)
UPDATE_MIN_FREE_MB=1024
# Set by docker-compose.prod.yml, never by hand: where the updater keeps its history and the socket guard's address
UPDATE_STATE_DIR=
UPDATE_HOOK_PORT=
DOCKER_GUARD_URL=
SERVER_URL=
GUARD_PORT=
# The end-to-end test of the updater only (scripts/updater-e2e.mjs): a registry on localhost instead of
# ghcr.io/dopetast1c/marksy-, and the key its images are signed with. Refused for any other registry.
UPDATE_IMAGE_PREFIX=
UPDATE_TEST_COSIGN_KEY=
UPDATE_TEST_REGISTRY_FORWARD=

# --- Backups (the backup service, docs/running.md) ---
# The host folder the backups go to, outside the repository (D:\marksy-backups, a folder on a USB disk, a NAS share)
BACKUP_DIR=./backups
# The daily backup's local time; a day missed while the host was off is taken soon after it starts
BACKUP_TIME=03:30

# --- Development only: your own family on your own machine (docs/build-plan.md, "Data for testing") ---
# Your diary login. Used by `pnpm probe` (M2), `pnpm sync:once` (M3) and `pnpm dev:connect` (M4); Claude Code may run
# them within the login guard (CLAUDE.md, "Real diary runs"). The app itself keeps diary credentials in the
# database, encrypted; these two lines exist only so you do not type them into the UI after every database reset.
# .env is gitignored and Claude Code is not allowed to read it.
DIARY_LOGIN=
DIARY_PASSWORD=
# The limits of the manual real runs (pnpm probe, pnpm sync:once, pnpm dev:connect; server/src/cli/mode.ts).
# development (exactly this word): one diary login per account every DEV_MIN_LOGIN_INTERVAL_MINUTES (10 or more; a
# lower value counts as 10), at any hour, no daily cap. Anything else, an empty or misspelt value included, is
# production: the provider's interval (60 minutes for most), and Claude Code at most three runs a day between 07:00
# and 20:00 school time. On the machine that runs the app for the family, set production. In both, Claude Code never
# retries a login the diary refused, and scheduled syncs keep the product's rules (docs/design.md 10.2).
MARKSY_ENV=development
DEV_MIN_LOGIN_INTERVAL_MINUTES=10
# true once a production instance reads the same diary accounts (pnpm env:dev --production-active): the two databases
# do not share their login times, so development runs then keep the production limits too (docs/running.md)
PRODUCTION_ACTIVE=
# A production build sets NODE_ENV=production, which always means the production mode above, whatever MARKSY_ENV says.
# Leave it unset for development.
# NODE_ENV=production
# Who starts a manual real run: empty for you; .claude/settings.json sets "claude" for Claude Code, whose runs in
# production the login guard limits to three a day in school hours. Leave it empty here.
MARKSY_RUNNER=
# The Marksy login `pnpm dev:connect` creates for you (any e-mail you like; it never leaves this machine)
MARKSY_DEV_EMAIL=
MARKSY_DEV_PASSWORD=

# --- Tests only ---
# 1 rewrites providers/<id>/fixtures/expected/canonical.json in `pnpm test:provider <id>` (refused while any fixture
# carries something on the provider's denylist). Set it on the command line for one run, not here.
MARKSY_UPDATE_EXPECTED=
# 1 makes `pnpm probe` print the command it would run and stop, without logging in: for testing the launcher.
MARKSY_PROBE_DRY_RUN=
