{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm install -g pnpm*)",
      "Bash(node *)",
      "Bash(docker version*)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git merge *)",
      "Bash(git push*)",
      "Bash(git init*)",
      "Bash(git remote*)",
      "Bash(git config user.*)",
      "Bash(git stash*)",
      "Bash(git tag*)",
      "Bash(curl -s http://localhost*)",
      "Bash(gh auth status*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo view*)"
    ],
    "ask": [
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git config --global *)",
      "Bash(docker compose down *)",
      "Bash(pnpm db:reset*)",
      "Bash(pnpm probe*)",
      "Bash(pnpm sync:once*)",
      "Bash(pnpm dev:connect*)",
      "Bash(docker compose exec *)",
      "Bash(docker exec *)",
      "Bash(psql *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./data/**)",
      "Read(./**/*.har)",
      "Read(./**/*.dump)"
    ]
  }
}
