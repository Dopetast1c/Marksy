{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GCM_INTERACTIVE": "never",
    "MARKSY_RUNNER": "claude"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm install -g pnpm*)",
      "Bash(node *)",
      "Bash(docker version*)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git merge *)",
      "Bash(git push*)",
      "Bash(git init*)",
      "Bash(git remote*)",
      "Bash(git config user.*)",
      "Bash(git stash*)",
      "Bash(git tag*)",
      "Bash(curl -s http://localhost*)",
      "Bash(gh auth status*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo view*)",
      "Bash(pnpm probe*)",
      "Bash(pnpm sync:once*)",
      "Bash(pnpm dev:connect*)",
      "Bash(pnpm run probe*)",
      "Bash(pnpm run sync:once*)",
      "Bash(pnpm --filter * probe*)",
      "Bash(pnpm --filter * sync:once*)",
      "Bash(pnpm -F * probe*)",
      "Bash(pnpm -F * sync:once*)",
      "Bash(pnpm --dir * probe*)",
      "Bash(pnpm -C * probe*)",
      "Bash(node scripts/probe.mjs*)"
    ],
    "ask": [
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git config --global *)",
      "Bash(docker compose down *)",
      "Bash(pnpm db:reset*)",
      "Bash(docker compose exec *)",
      "Bash(docker exec *)",
      "Bash(psql *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)"
    ],
    "deny": [
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Read(./**/*.har)",
      "Read(./**/*.dump)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.test)",
      "Read(./**/.env.test)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./.env.bak)",
      "Read(./**/.env.bak)",
      "Read(./.env.backup)",
      "Read(./**/.env.backup)",
      "Read(./.env.old)",
      "Read(./**/.env.old)",
      "Read(./.env.orig)",
      "Read(./**/.env.orig)",
      "Read(./.env.save)",
      "Read(./**/.env.save)",
      "Read(./.env.copy)",
      "Read(./**/.env.copy)",
      "Read(./.env - Copy*)",
      "Read(./**/.env - Copy*)",
      "Bash(cat *.env)",
      "Bash(cat *.env.*local)",
      "Bash(cat *.env.development)",
      "Bash(cat *.env.production)",
      "Bash(cat *.env.test)",
      "Bash(type *.env)",
      "Bash(type *.env.*local)",
      "Bash(type *.env.development)",
      "Bash(type *.env.production)",
      "Bash(type *.env.test)",
      "Bash(head *.env)",
      "Bash(head *.env.*local)",
      "Bash(head *.env.development)",
      "Bash(head *.env.production)",
      "Bash(head *.env.test)",
      "Bash(tail *.env)",
      "Bash(tail *.env.*local)",
      "Bash(tail *.env.development)",
      "Bash(tail *.env.production)",
      "Bash(tail *.env.test)",
      "Bash(less *.env)",
      "Bash(less *.env.*local)",
      "Bash(less *.env.development)",
      "Bash(less *.env.production)",
      "Bash(less *.env.test)",
      "Bash(more *.env)",
      "Bash(more *.env.*local)",
      "Bash(more *.env.development)",
      "Bash(more *.env.production)",
      "Bash(more *.env.test)",
      "Bash(grep * *.env)",
      "Bash(grep * *.env.*local)",
      "Bash(grep * *.env.development)",
      "Bash(grep * *.env.production)",
      "Bash(grep * *.env.test)",
      "Bash(rg * *.env)",
      "Bash(rg * *.env.*local)",
      "Bash(rg * *.env.development)",
      "Bash(rg * *.env.production)",
      "Bash(rg * *.env.test)",
      "Bash(* < *.env)",
      "Bash(* < *.env.*local)",
      "Bash(* < *.env.development)",
      "Bash(* < *.env.production)",
      "Bash(* < *.env.test)",
      "Bash(cat *.env.bak)",
      "Bash(cat *.env.backup)",
      "Bash(cat *.env.old)",
      "Bash(cat *.env.orig)",
      "Bash(cat *.env.save)",
      "Bash(cat *.env.copy)",
      "Bash(cat *.env - Copy*)",
      "Bash(type *.env.bak)",
      "Bash(type *.env.backup)",
      "Bash(type *.env.old)",
      "Bash(type *.env.orig)",
      "Bash(type *.env.save)",
      "Bash(type *.env.copy)",
      "Bash(type *.env - Copy*)",
      "Bash(head *.env.bak)",
      "Bash(head *.env.backup)",
      "Bash(head *.env.old)",
      "Bash(head *.env.orig)",
      "Bash(head *.env.save)",
      "Bash(head *.env.copy)",
      "Bash(head *.env - Copy*)",
      "Bash(tail *.env.bak)",
      "Bash(tail *.env.backup)",
      "Bash(tail *.env.old)",
      "Bash(tail *.env.orig)",
      "Bash(tail *.env.save)",
      "Bash(tail *.env.copy)",
      "Bash(tail *.env - Copy*)",
      "Bash(less *.env.bak)",
      "Bash(less *.env.backup)",
      "Bash(less *.env.old)",
      "Bash(less *.env.orig)",
      "Bash(less *.env.save)",
      "Bash(less *.env.copy)",
      "Bash(less *.env - Copy*)",
      "Bash(more *.env.bak)",
      "Bash(more *.env.backup)",
      "Bash(more *.env.old)",
      "Bash(more *.env.orig)",
      "Bash(more *.env.save)",
      "Bash(more *.env.copy)",
      "Bash(more *.env - Copy*)",
      "Bash(grep * *.env.bak)",
      "Bash(grep * *.env.backup)",
      "Bash(grep * *.env.old)",
      "Bash(grep * *.env.orig)",
      "Bash(grep * *.env.save)",
      "Bash(grep * *.env.copy)",
      "Bash(grep * *.env - Copy*)",
      "Bash(rg * *.env.bak)",
      "Bash(rg * *.env.backup)",
      "Bash(rg * *.env.old)",
      "Bash(rg * *.env.orig)",
      "Bash(rg * *.env.save)",
      "Bash(rg * *.env.copy)",
      "Bash(rg * *.env - Copy*)",
      "Bash(* < *.env.bak)",
      "Bash(* < *.env.backup)",
      "Bash(* < *.env.old)",
      "Bash(* < *.env.orig)",
      "Bash(* < *.env.save)",
      "Bash(* < *.env.copy)",
      "Bash(* < *.env - Copy*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * --delete main*)",
      "Bash(git push * --delete * main*)",
      "Bash(git push --delete main*)",
      "Bash(git push --delete * main*)",
      "Bash(git push * -d main*)",
      "Bash(git push * -d * main*)",
      "Bash(git push * :main*)",
      "Bash(git push * :refs/heads/main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git -c *core.hooksPath*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config * core.hooksPath*)",
      "Bash(git add -f*)",
      "Bash(git add * -f*)",
      "Bash(git add --force*)",
      "Bash(git add * --force*)"
    ]
  }
