{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GCM_INTERACTIVE": "never",
    "MARKSY_RUNNER": "claude"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm -F *)",
      "Bash(pnpm run *)",
      "Bash(npm install -g pnpm*)",
      "Bash(node *)",
      "Bash(docker version*)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git merge *)",
      "Bash(git push*)",
      "Bash(git init*)",
      "Bash(git remote*)",
      "Bash(git config user.*)",
      "Bash(git stash*)",
      "Bash(git tag*)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl -s -i http://localhost*)",
      "Bash(curl -s -H * http://localhost*)",
      "Bash(docker logs *)",
      "Bash(docker stats --no-stream *)",
      "Bash(docker image inspect *)",
      "Bash(docker manifest inspect ghcr.io/dopetast1c/*)",
      "Bash(docker pull ghcr.io/dopetast1c/*)",
      "Bash(docker build -f D:/GIT/marksy/*)",
      "Bash(docker tag * ghcr.io/dopetast1c/*:local)",
      "Bash(docker compose * -f D:/GIT/marksy/docker-compose.prod.yml up *)",
      "Bash(docker compose * -f D:/GIT/marksy/docker-compose.prod.yml stop*)",
      "Bash(docker compose * -f D:/GIT/marksy/docker-compose.prod.yml ps*)",
      "Bash(docker compose * -f D:/GIT/marksy/docker-compose.prod.yml logs *)",
      "Bash(gh auth status*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo view*)",
      "Bash(pnpm probe*)",
      "Bash(pnpm sync:once*)",
      "Bash(pnpm dev:connect*)",
      "Bash(pnpm run probe*)",
      "Bash(pnpm run sync:once*)",
      "Bash(pnpm --filter * probe*)",
      "Bash(pnpm --filter * sync:once*)",
      "Bash(pnpm -F * probe*)",
      "Bash(pnpm -F * sync:once*)",
      "Bash(pnpm --dir * probe*)",
      "Bash(pnpm -C * probe*)",
      "Bash(node scripts/probe.mjs*)"
    ],
    "ask": [
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git config --global *)",
      "Bash(docker compose down *)",
      "Bash(pnpm db:reset*)",
      "Bash(docker compose exec *)",
      "Bash(docker exec *)",
      "Bash(docker rm *)",
      "Bash(docker volume rm *)",
      "Bash(docker network rm *)",
      "Bash(docker compose * down*)",
      "Bash(psql *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)"
    ],
    "deny": [
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Read(./**/*.har)",
      "Read(./**/*.dump)",
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep * *.env*)",
      "Bash(rg * *.env*)",
      "Bash(* < *.env*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * --delete main*)",
      "Bash(git push * --delete * main*)",
      "Bash(git push --delete main*)",
      "Bash(git push --delete * main*)",
      "Bash(git push * -d main*)",
      "Bash(git push * -d * main*)",
      "Bash(git push * :main*)",
      "Bash(git push * :refs/heads/main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git -c *core.hooksPath*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config * core.hooksPath*)",
      "Bash(git add -f*)",
      "Bash(git add * -f*)",
      "Bash(git add --force*)",
      "Bash(git add * --force*)"
    ]
  }
}
